{
  "name": "krusch-stack",
  "version": "1.3.2",
  "mcpName": "dev.krusch/krusch-stack",
  "description": "The unified Sovereign AI & Coding Agent Stack: one-command installer and MCP gateway bundling Tier 1 Working Memory & Git Alignment (krusch-context-mcp), Tier 2A Git DAG & AST Graph (krusch-git), Tier 2B Page-Anchored OS Filesystem (krusch-fs), Tier 2C HydraScope Structural Context & Temporal Ontology, Tier 2D Collaborative Brick Exchange & 4-Axis Ontology, Tier 3 Staged 2PC & Turn-0 Grounded Harnesses (krusch-harness + grounded-harness), Frontend Design Engine (krusch-frontend-mcp), Local Workspace Hub (krusch-workspace), Sovereign ToolGraph, Polyglot Audit, and L1-L3 Cascade Router.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "krusch-stack": "./bin/krusch-stack.js",
    "kruschstack": "./bin/krusch-stack.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./mcp": "./src/mcp/server.js",
    "./sqlite": "./src/db/sqlite.js",
    "./installer": "./src/installer/ide-config.js",
    "./doctor": "./src/installer/doctor.js",
    "./demo": "./src/installer/demo.js",
    "./observability": "./src/engines/observability-engine.js",
    "./resilience": "./src/engines/resilience-engine.js",
    "./action-harness": "./src/engines/action-harness-engine.js",
    "./grounded-harness": "./src/engines/grounded-harness-engine.js",
    "./grounded-auth-drift": "./src/engines/grounded-auth-drift.js",
    "./grounded-trace-synthesizer": "./src/engines/grounded-trace-synthesizer.js",
    "./brick-exchange": "./src/engines/brick-exchange-engine.js",
    "./brick-ontology": "./src/engines/brick-ontology-engine.js",
    "./hydrascope": "./src/engines/hydrascope-engine.js",
    "./git-alignment": "./src/engines/git-alignment-engine.js",
    "./tool-graph": "./src/engines/tool-graph-engine.js",
    "./polyglot-audit": "./src/engines/polyglot-audit-engine.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "db",
    "docs/PRODUCTION.md",
    "docs/guides",
    "scripts",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example",
    "server.json",
    "spec.md",
    "BENCHMARKS.md",
    "CONTRIBUTING.md",
    "INSTALL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/krusch-stack.js mcp",
    "mcp": "node bin/krusch-stack.js mcp",
    "init": "node bin/krusch-stack.js init",
    "demo": "node bin/krusch-stack.js demo",
    "doctor": "node bin/krusch-stack.js doctor",
    "explain": "node bin/krusch-stack.js explain",
    "serve": "node bin/krusch-stack.js serve",
    "test": "node --test tests/*.test.js",
    "bench:repro": "node scripts/reproduce_clean_room.js",
    "bench:beam:parity": "node scripts/benchmark_beam_parity.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "coding-agents",
    "agentic-ai",
    "claude-code",
    "cursor",
    "windsurf",
    "antigravity",
    "ast-graph",
    "git-dag",
    "episodic-memory",
    "coding-harness",
    "grounded-harness",
    "turn-zero-grounding",
    "cascade-router",
    "design-system",
    "workspace-rag",
    "sqlite",
    "pgvector",
    "sovereign-ai",
    "brick-exchange",
    "brick-ontology",
    "hydrascope",
    "tool-graph",
    "git-alignment",
    "polyglot-audit",
    "hexagonal-architecture",
    "blast-radius"
  ],
  "author": "kruschdev <kruschdev@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruschdev/krusch-stack.git"
  },
  "homepage": "https://github.com/kruschdev/krusch-stack#readme",
  "bugs": {
    "url": "https://github.com/kruschdev/krusch-stack/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "overrides": {
    "fast-uri": "^4.2.3",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.9"
  }
}
