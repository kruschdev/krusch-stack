{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.krusch/krusch-stack",
  "title": "KruschStack",
  "description": "Local SQLite control plane for coding agents: persistent memory, Turn-0 grounding, and 2PC safety.",
  "repository": {
    "url": "https://github.com/kruschdev/krusch-stack",
    "source": "github"
  },
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "krusch-stack",
      "version": "1.3.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--profile",
          "description": "Tool profile: memory-only (5), coding-agent (19), core (27), or full (39)",
          "default": "coding-agent"
        }
      ],
      "environmentVariables": [
        {
          "name": "KRUSCH_WORKSPACE_ROOT",
          "description": "Target project workspace root directory",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
