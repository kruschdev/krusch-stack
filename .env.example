# KruschStack Unified Configuration
# By default, KruschStack runs with zero external dependencies using Node 22 native SQLite (.krusch-stack/stack.db).

# Optional Companion PostgreSQL 16 + pgvector URL (db/init.sql provisions all 21 tables for Docker Compose;
# KruschStack runtime executes against Node 22 native node:sqlite).
# DATABASE_URL=postgresql://krusch:krusch_stack_local@127.0.0.1:5432/krusch_stack

# Optional Local Ollama & Cloud Frontier Router Endpoints
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BURST_HOST=http://127.0.0.1:11435
KRUSCH_STACK_HOST=127.0.0.1
KRUSCH_STACK_PORT=3780
KRUSCH_ALLOWED_HOSTS=
KRUSCH_STACK_API_TOKEN=
KRUSCH_STACK_PROFILE=full
KRUSCH_STACK_INCLUDE_EXTENDED=false
KRUSCH_MAX_BODY_BYTES=2097152
KRUSCH_EPHEMERAL=0

# Optional Storage, Workspace, Deferred MCP, HydraScope OpenCypher, Embedding & HITL Overrides
DB_PATH=.krusch-stack/stack.db
KRUSCH_WORKSPACE_ROOT=
KRUSCH_STACK_DEFER_TOOLS=false
HYDRADB_URL=
HYDRADB_TOKEN=
HYDRADB_GRAPH_ID=hydrascope
KRUSCH_EMBED_URL=http://127.0.0.1:11434
KRUSCH_EMBED_MODEL=snowflake-arctic-embed2
SLACK_SIGNING_SECRET=
