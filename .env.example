# KruschStack Unified Configuration
# By default, KruschStack runs with zero external dependencies using Node 22 native SQLite (.krusch-stack/stack.db).

# Optional PostgreSQL 16 + pgvector upgrade (used by `docker compose up -d`)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/krusch_stack

# Optional Local Ollama & Cloud Frontier Router Endpoints
OLLAMA_HOST=http://127.0.0.1:11434
KRUSCH_STACK_PORT=3780
KRUSCH_STACK_PROFILE=full
